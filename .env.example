# odds-api.io free tier API key (100 req/hr, no credit card required)
# Get yours at: https://odds-api.io/#pricing
ODDS_API_KEY=your_api_key_here

# Server config
HOST=0.0.0.0
PORT=8080

# Refresh interval in seconds (4 minutes = 240, fits 100 req/hr free tier)
REFRESH_INTERVAL=240

# Bookmaker to pull odds from (case-insensitive match)
# BetOnline.ag = near-identical lines to BookMaker.eu, confirmed working
# BookMaker.eu = listed but API currently returns no odds data for it
BOOKMAKER=BetOnline.ag
